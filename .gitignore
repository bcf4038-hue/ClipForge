# Your private stuff: never goes to GitHub
config.json
cookies.txt
usage.json
styles.json
profile.json
projects/
.version

# Working files and finished clips
work/
output/

# Your own sounds (the folders stay, the files don't)
sounds/my_sfx/*
sounds/my_music/*
!sounds/my_sfx/.keep
!sounds/my_music/.keep

# Recorded quiz voices
sounds/voice_lines/

# Your own fonts
fonts/*
!fonts/.keep

# Python
.venv/
__pycache__/
*.pyc
# Local secrets written by `elevenlabs onboard`
/.env
